---
interface Props {
  href: string;
  title: string;
  description: string;
  itemCount: string;
  index: string;
  image?: string;
}
const { href, title, description, itemCount, index, image } = Astro.props;
---

<a href={href} class="cat-card">
  {image && (
    <img
      class="cat-img smart-img"
      data-base={image}
      alt={title}
      loading="lazy"
    />
  )}
  <span class="cat-index">{index}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="cat-meta">{itemCount} <span class="arrow">→</span></span>
</a>

<style>
  .cat-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--steel-200);
    border-radius: var(--radius);
    padding: 32px;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: transform 0.15s ease, border-color 0.15s ease;
    min-height: 220px;
  }
  .cat-card:hover { transform: translateY(-3px); border-color: var(--signal); }
  .cat-index {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--signal-dark);
    margin-bottom: 14px;
  }
  .cat-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 16px;
    background: var(--steel-100);
  }
  .cat-img.hidden { display: none; }
  .cat-card h3 { margin-bottom: 8px; }
  .cat-card p { font-size: 0.92rem; flex-grow: 1; }
  .cat-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--navy-800);
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .arrow { transition: transform 0.15s ease; }
  .cat-card:hover .arrow { transform: translateX(3px); }
</style>
