---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'SK Engineers & Conveyor Systems — custom-engineered belt, roller, spiral and telescopic conveyor systems, designed and manufactured in Delhi, India.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title} · SK Engineers & Conveyors</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Tries multiple file extensions for product images so it doesn't
      // matter whether a gallery photo was saved as .jpg, .png, or .webp —
      // only the base filename (before the extension) needs to match.
      const EXTS = ['jpg', 'jpeg', 'png', 'webp'];
      document.querySelectorAll<HTMLImageElement>('img.smart-img[data-base]').forEach((img) => {
        let i = 0;
        const base = img.dataset.base;
        const tryNext = () => {
          if (i >= EXTS.length) {
            img.classList.add('hidden');
            img.removeEventListener('error', tryNext);
            return;
          }
          img.src = `${base}.${EXTS[i++]}`;
        };
        img.addEventListener('error', tryNext);
        tryNext();
      });
    </script>
  </body>
</html>
